{
  "name": "offline-mesh-review1", "private": true, "version": "0.1.0",
  "type": "module", "workspaces": ["packages/core", "apps/web", "apps/server"],
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w @mesh/server\" \"npm run dev -w @mesh/web\"",
    "dev:web": "npm run dev -w @mesh/web", "dev:server": "npm run dev -w @mesh/server",
    "build": "npm run build -w @mesh/web", "test": "node --test tests/*.test.js",
    "mobile:install": "npm --prefix apps/mobile install",
    "mobile:android": "npm --prefix apps/mobile run android"
  },
  "devDependencies": {"concurrently": "^9.2.1", "supertest": "^7.1.4"}
}
